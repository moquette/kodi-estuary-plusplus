	<include name="InfoWallMovieLayout">
		<param name="focused">false</param>
		<param name="infolabels">false</param>
		<definition>
			<control type="group">
				<!-- Poster-less card. Normally driven by empty poster art; in the
				     Videos search results window (10025) a POV result that TMDb has
				     no poster for arrives with its poster art set to POV's own white
				     film-strip placeholder (box_office.png), and a POV "Next Page"
				     item arrives with the folder/arrow placeholder (item_next.png),
				     so the poster is not empty and this branch would be skipped,
				     leaving the bare placeholder on screen. Treating either POV
				     placeholder as "no real poster" here routes it to the skin's
				     native titled card with a DefaultMovies fallback, exactly as a
				     truly poster-less library movie renders. Scoped to the Videos
				     window so Home and other views are untouched. -->
				<visible>[String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster)) + String.IsEmpty(ListItem.Art(animatedposter))] | [Window.IsVisible(10025) + [String.Contains(ListItem.Art(poster),box_office.png) | String.Contains(ListItem.Art(poster),item_next.png)]]</visible>
				<control type="image">
					<left>13</left>
					<top>-12</top>
					<width>294</width>
					<height>404</height>
					<texture colordiffuse="$VAR[BorderColorVar]" diffuse="masks/poster-border.png">colors/white.png</texture>
					<aspectratio>stretch</aspectratio>
					<bordertexture border="21">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
					<visible>Skin.HasSetting(show_borders) + !String.IsEqual(listitem.dbtype,genre)</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<texture diffuse="masks/poster.png">dialogs/dialog-bg-nobo.png</texture>
					<bordersize>20</bordersize>
					<visible>Skin.HasSetting(show_borders) + !String.IsEqual(listitem.dbtype,genre)</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<texture diffuse="masks/poster.png">dialogs/dialog-bg-nobo.png</texture>
					<bordertexture border="21">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
					<visible>Skin.HasSetting(show_borders) + String.IsEqual(listitem.dbtype,genre)</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<texture diffuse="masks/poster.png">dialogs/dialog-bg-nobo.png</texture>
					<bordertexture border="21">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
					<visible>!Skin.HasSetting(show_borders)</visible>
				</control>
				<control type="image">
					<left>9</left>
					<top>-16</top>
					<width>302</width>
					<height>412</height>
					<texture colordiffuse="$VAR[SkinColorVar]" diffuse="masks/poster-focus.png">colors/grey.png</texture>
					<bordersize>20</bordersize>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="image">
					<left>9</left>
					<top>-16</top>
					<width>302</width>
					<height>412</height>
					<texture colordiffuse="$VAR[GradientColorVar]" diffuse="masks/poster-focus.png">colors/gradient.png</texture>
					<bordersize>20</bordersize>
					<visible>$PARAM[focused]</visible>
					<visible>Skin.HasSetting(EnableGradientColor)</visible>
				</control>
				<control type="textbox">
					<left>40</left>
					<top>244</top>
					<width>242</width>
					<height>120</height>
					<font>font27</font>
					<align>center</align>
					<aligny>center</aligny>
					<label>$VAR[ListLabelVar]</label>
					<autoscroll time="2000" delay="3000" repeat="5000">$PARAM[focused]</autoscroll>
					<visible>!ListItem.IsParentFolder</visible>
					<visible>![!Skin.HasSetting(HideWidgetLabels) + Window.IsVisible(Home)  + String.IsEqual(listitem.dbtype,genre)]</visible>
				</control>
				<control type="image">
					<left>24</left>
					<top>-1</top>
					<width>272</width>
					<height>270</height>
					<texture fallback="DefaultMovies.png" background="true">$INFO[ListItem.Icon]</texture>
					<aspectratio>scale</aspectratio>
					<bordersize>20</bordersize>
					<visible>Skin.HasSetting(HideWidgetLabels) + ![String.IsEqual(listitem.dbtype,genre) | String.IsEqual(listitem.dbtype,studio)]</visible>
					<visible>![Window.IsVisible(10025) + [String.Contains(ListItem.Art(poster),box_office.png) | String.Contains(ListItem.Art(poster),item_next.png)]]</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<texture fallback="DefaultMovies.png" background="true" diffuse="masks/poster.png">$INFO[ListItem.Icon]</texture>
					<aspectratio>scale</aspectratio>
					<bordersize>20</bordersize>
					<visible>!String.IsEqual(listitem.dbtype,genre) + !String.IsEqual(listitem.dbtype,studio)</visible>
					<visible>![Window.IsVisible(10025) + [String.Contains(ListItem.Art(poster),box_office.png) | String.Contains(ListItem.Art(poster),item_next.png)]]</visible>
				</control>
				<!-- Native DefaultMovies fallback for a POV placeholder poster in the
				     Videos results window: the placeholder ListItem.Icon above is
				     suppressed for this case and this draws the same DefaultMovies.png
				     that Home.xml uses for a poster-less movie, inside the rounded
				     poster frame. -->
				<control type="image">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<texture background="true" diffuse="masks/poster.png">DefaultMovies.png</texture>
					<aspectratio>keep</aspectratio>
					<bordersize>20</bordersize>
					<visible>Window.IsVisible(10025) + [String.Contains(ListItem.Art(poster),box_office.png) | String.Contains(ListItem.Art(poster),item_next.png)] + !String.IsEqual(listitem.dbtype,genre) + !String.IsEqual(listitem.dbtype,studio)</visible>
				</control>
				<control type="image">
					<left>54</left>
					<top>40</top>
					<width>212</width>
					<height>212</height>
					<texture fallback="DefaultGenre.png">$VAR[WidgetGenreIconVar]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<visible>String.IsEqual(listitem.dbtype,genre)</visible>
					<animation effect="slide" end="0,44" time="0" condition="Window.IsVisible(Home)">Conditional</animation>
				</control>
				<control type="image">
					<left>54</left>
					<top>40</top>
					<width>212</width>
					<height>212</height>
					<texture fallback="DefaultStudios.png">$VAR[WidgetStudioIconVar]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<visible>String.IsEqual(listitem.dbtype,studio)</visible>
					<animation effect="slide" end="0,44" time="0" condition="Window.IsVisible(Home)">Conditional</animation>
				</control>
			</control>
			<control type="group">
				<visible>![String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster)) + String.IsEmpty(ListItem.Art(animatedposter))] + ![Window.IsVisible(10025) + [String.Contains(ListItem.Art(poster),box_office.png) | String.Contains(ListItem.Art(poster),item_next.png)]]</visible>
				<control type="group">
					<left>9</left>
					<top>-16</top>
					<width>302</width>
					<height>412</height>
					<control type="image">
						<texture colordiffuse="$VAR[SkinColorVar]" diffuse="masks/poster-focus.png">colors/grey.png</texture>
						<bordersize>20</bordersize>
						<visible>$PARAM[focused]</visible>
					</control>
					<control type="image">
						<texture colordiffuse="$VAR[GradientColorVar]" diffuse="masks/poster-focus.png">colors/gradient.png</texture>
						<bordersize>20</bordersize>
						<visible>$PARAM[focused]</visible>
						<visible>Skin.HasSetting(EnableGradientColor)</visible>
					</control>
				</control>
				<control type="group">
					<left>15</left>
					<top>-10</top>
					<width>290</width>
					<height>400</height>
					<control type="image">
						<texture background="true" diffuse="masks/poster.png">dialogs/dialog-bg-nobo.png</texture>
						<aspectratio>stretch</aspectratio>
						<bordersize>20</bordersize>
					</control>
					<control type="image">
						<texture background="true">DefaultMovies.png</texture>
						<aspectratio>keep</aspectratio>
						<bordersize>20</bordersize>
					</control>
					<control type="image">
						<texture background="true" diffuse="masks/poster.png">$VAR[IconWallPosterVar]</texture>
						<aspectratio>stretch</aspectratio>
						<bordersize>20</bordersize>
					</control>
				</control>
				<control type="image">
					<left>13</left>
					<top>-12</top>
					<width>294</width>
					<height>404</height>
					<texture colordiffuse="$VAR[BorderColorVar]" diffuse="masks/poster-border.png">colors/white.png</texture>
					<aspectratio>stretch</aspectratio>
					<bordertexture border="21">overlays/shadow.png</bordertexture>
					<bordersize>20</bordersize>
					<visible>!$PARAM[focused]</visible>
					<visible>Skin.HasSetting(show_borders)</visible>
				</control>
			</control>
			<control type="group">
				<visible>String.IsEqual(ListItem.DBtype,tvshow) + !String.IsEmpty(Skin.String(EpisodesDisplay)) + !String.IsEqual(Skin.String(EpisodesDisplay),31578) + !String.IsEmpty(ListItem.Property(TotalEpisodes))</visible>
				<top>320</top>
				<control type="image">
					<left>35</left>
					<top>0</top>
					<width>250</width>
					<height>50</height>
					<texture colordiffuse="CCFFFFFF" diffuse="masks/poster-band.png">overlays/overlayfade.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>20</top>
					<width>244</width>
					<label>$INFO[ListItem.Property(WatchedEpisodes),, / ]$INFO[ListItem.Property(TotalEpisodes)]</label>
					<font>font20_title</font>
					<shadowcolor>$VAR[ShadowColorVar]</shadowcolor>
					<align>right</align>
					<visible>String.IsEqual(Skin.String(EpisodesDisplay),31680)</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>20</top>
					<width>244</width>
					<label>$INFO[ListItem.Property(UnwatchedEpisodes),, / ]$INFO[ListItem.Property(TotalEpisodes)]</label>
					<font>font20_title</font>
					<shadowcolor>$VAR[ShadowColorVar]</shadowcolor>
					<align>right</align>
					<visible>String.IsEqual(Skin.String(EpisodesDisplay),31681)</visible>
				</control>
				<control type="group">
					<left>254</left>
					<top>23</top>
					<width>24</width>
					<height>24</height>
					<control type="image">
						<texture>lists/played-total.png</texture>
						<visible>!String.IsEmpty(ListItem.Property(WatchedEpisodes)) + String.IsEqual(Skin.String(EpisodesDisplay),31680)</visible>
					</control>
					<control type="image">
						<texture>lists/played-unwatched.png</texture>
						<visible>!String.IsEmpty(ListItem.Property(UnwatchedEpisodes)) + String.IsEqual(Skin.String(EpisodesDisplay),31681)</visible>
					</control>
						<control type="image">
						<texture>lists/items-total.png</texture>
						<visible>String.IsEmpty(ListItem.Property(WatchedEpisodes)) + String.IsEmpty(ListItem.Property(UnwatchedEpisodes)) + !String.IsEmpty(Skin.String(EpisodesDisplay)) + !String.IsEqual(Skin.String(EpisodesDisplay),31578)</visible>
					</control>
				</control>
			</control>
			<control type="group">
				<left>35</left>
				<top>290</top>
				<visible>![String.IsEqual(listitem.dbtype,genre) | String.IsEqual(listitem.dbtype,studio)]</visible>
				<control type="image">
					<top>-20</top>
					<width>100</width>
					<height>100</height>
					<texture>overlays/overlay-bg-round.png</texture>
				</control>
				<control type="image">
					<left>10</left>
					<top>38</top>
					<width>32</width>
					<height>32</height>
					<texture>$VAR[WallWatchedIconVar]</texture>
				</control>
			</control>
			<control type="image">
				<left>35</left>
				<top>10</top>
				<width>250</width>
				<height>360</height>
				<texture background="true" colordiffuse="BFFFFFFF" diffuse="masks/poster.png">colors/black.png</texture>
				<aspectratio>stretch</aspectratio>
				<visible>!$PARAM[focused]</visible>
				<visible>Skin.HasSetting(greyedout_watched) + Integer.IsGreater(ListItem.Playcount,0) + !Window.IsVisible(Home) + !Skin.HasSetting(show_borders) + !String.IsEqual(listitem.dbtype,genre)</visible>
			</control>
			<control type="image">
				<left>33</left>
				<top>8</top>
				<width>254</width>
				<height>364</height>
				<texture background="true" colordiffuse="BFFFFFFF" diffuse="masks/poster.png">colors/black.png</texture>
				<aspectratio>stretch</aspectratio>
				<visible>!$PARAM[focused]</visible>
				<visible>Skin.HasSetting(greyedout_watched) + Integer.IsGreater(ListItem.Playcount,0) + !Window.IsVisible(Home) + Skin.HasSetting(show_borders) + !String.IsEqual(listitem.dbtype,genre)</visible>
			</control>
			<control type="group">
				<include content="RatingCorner" condition="Skin.HasSetting(circle_rating) | Skin.HasSetting(circle_userrating) | Skin.HasSetting(circle_bothrating)">
					<param name="art-left" value="35" />
					<param name="art-top" value="10" />
					<param name="art-width" value="250" />
					<param name="size" value="100" />
					<param name="corner" value="overlays/overlay-bg-round.png" />

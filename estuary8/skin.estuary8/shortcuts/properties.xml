		<button id="14771" property="widgetAspect.3" type="select" title="$LOCALIZE[31337] 3" showNone="false"/>
		<button id="14772" property="widgetSortBy.3" type="select" title="$LOCALIZE[31367] 3" showNone="true"/>
		<button id="14773" property="widgetSortDirection.3" type="select" title="$LOCALIZE[31368] 3" showNone="true"/>
		<button id="14781" property="widgetAspect.4" type="select" title="$LOCALIZE[31337] 4" showNone="false"/>

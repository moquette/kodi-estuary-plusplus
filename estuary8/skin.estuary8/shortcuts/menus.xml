<?xml version="1.0" encoding="UTF-8"?>
<menus>

	<!--
		Skin Shortcuts 3.0.1 config for Estuary 8, converted from MOD V2's v2
		files that still sit beside it (mainmenu.DATA.xml, overrides.xml,
		template.xml). Those are inert under v3 and were deliberately left in
		place. Upstream never ported Skin Shortcuts at all, so this file and
		its four siblings are Estuary 8's own and have no upstream counterpart.

		Routing. MOD V2's Home.xml picks a widget panel with
		Container(9000).ListItem.Property(widget), and its 15-line <onright>
		block at Home.xml:1860-1874 does the same. v3 does not synthesise that
		property, but <item widget="..."> is a first-class attribute
		(loaders/menu.py:426-428): it lands in item.properties and the includes
		builder emits every item property verbatim (builders/includes.py:322-327).
		So all 13 stock panels plus the two Personal ones route with no markup
		change. This is the v3 spelling of overrides.xml's <widgetdefault>.
	-->

	<!-- This row has been relabelled twice in one day and the history is the
	     point, because both wrong labels were REAL STRINGS from unrelated
	     settings, which is why neither ever looked broken to a reader.
	       until 2026-07-31   $LOCALIZE[31053]  "Arial based", a FONT setting
	       then briefly       $LOCALIZE[166]    "Skin", correct but ambiguous:
	                          the same word sat on three rows opening two
	                          different folders, one of icons and one of
	                          backgrounds
	       now                $LOCALIZE[31724]  "Icons", this skin's own string
	     31724 is OURS, in the skin's own strings.po, and that is deliberate.
	     Kodi core has exactly two strings that read "Icons" and BOTH are wrong
	     here: 536 is the icon VIEW MODE, sitting between 535 "List" and 537
	     "Big list" under 534 "View: {0:s}", and 14302 is the PVR icons
	     SETTINGS GROUP label, whose group contains pvrmenu.iconpath. Taking
	     14302 because it happens to read "Icons" today would be the same
	     defect class as the two labels above, just harder to spot. -->
	<!-- The icon= attribute is what dresses these two rows. Without it the
	     picker draws Kodi's bare "+" placeholder against both, which is what
	     the owner was looking at until 2026-07-31. The add-on only calls
	     setArt when the attribute is non-empty (dialog/items.py:419-420), so
	     an absent attribute is a placeholder, not a default. Both textures are
	     in this skin's own media/Textures.xbt, verified by decoding the
	     bundle: defaultfolder.png 512x512 and defaultaddonssearch.png 256x256,
	     both real white glyphs with alpha, not empty frames. A name that is
	     NOT in the bundle draws nothing at all, which is worse than the "+",
	     so check the bundle before substituting either one.
	     The same pair is used on the three background sources in
	     backgrounds.xml, deliberately, so all three pickers read alike. -->
	<icons>
		<source label="$LOCALIZE[31724]" icon="DefaultFolder.png">special://skin/extras/icons/</source>
		<source label="$LOCALIZE[1024]" icon="DefaultAddonsSearch.png">browse</source>
	</icons>

	<!-- OFF deliberately. v3's context menu is a hard-coded five-item list
	     (dialog/items.py:440-446) and its "Edit Submenu" entry has no
	     visibility gate. Control 405 in script-skinshortcuts.xml DOES gate it:
	     MOD V2 excludes Pictures, Games, Favourites and Weather from having a
	     category submenu. The context menu route bypassed that, created a
	     submenu on an excluded item, and left hasSubmenu stale so control 401
	     stayed visible and the next shortcut pick wiped it again.
	     Nothing is lost: Edit Label, Edit Action, Change Icon and Delete all
	     have their own controls in the pane (305, 307, 306, and the IconButton
	     block at :112 which carries 301 add, 302 delete, 303 up, 304 down,
	     313 toggle disabled), and Edit Submenu is control 405. -->
	<contextmenu>false</contextmenu>


<?xml version="1.0" encoding="UTF-8"?>
<backgrounds>

	<!-- MOD V2's <backgrounddefault> set. <icon> is a CHILD element here, not
	     an attribute; the asymmetry with widgets.xml is real
	     (loaders/background.py:132). -->

	<!-- Every $LOCALIZE below was checked against the string table it actually
	     resolves in, on 2026-07-31. Three ids were wrong and are corrected here:
	     31053 (four uses) is this skin's "Arial based", a font setting, and 20093
	     is Kodi's "Profile name". Both resolved to a real, sensible-looking
	     string from an unrelated setting, so the file read fine and the DIALOG
	     was nonsense. 657 is "Browse for folder", which pairs with 1030
	     "Browse for image" on the sibling entry exactly as the two types
	     differ.
	     166 is Kodi's "Skin" and it survives on ONE thing only, the group
	     immediately below, which is a named set of ready-made backgrounds
	     rather than a folder to browse. The two <source> rows further down
	     carried the same 166 until later the same day and now read
	     $LOCALIZE[31725] "Backgrounds", because one word was naming two
	     different folders. That leaves "Skin >" and "Browse for image" one
	     line apart in the same chooser. Deliberate, and not a leftover: the
	     group really is the skin's own picks, and relabelling it was not
	     asked for. If it is ever revisited, it is a separate decision from
	     the source rows. -->
	<group name="skin" label="$LOCALIZE[166]" icon="DefaultPicture.png">
		<background name="disc" label="disc" type="static">
			<path>special://skin/extras/home-images/disc.jpg</path>
			<icon>special://skin/extras/home-images/disc.jpg</icon>
		</background>
		<background name="movies" label="movies" type="static">
			<path>special://skin/extras/home-images/movies.jpg</path>
			<icon>special://skin/extras/home-images/movies.jpg</icon>
		</background>
		<background name="tvshows" label="tvshows" type="static">
			<path>special://skin/extras/home-images/tvshows.jpg</path>
			<icon>special://skin/extras/home-images/tvshows.jpg</icon>
		</background>
		<background name="music" label="music" type="static">
			<path>special://skin/extras/home-images/music.jpg</path>
			<icon>special://skin/extras/home-images/music.jpg</icon>
		</background>
		<background name="musicvideos" label="musicvideos" type="static">
			<path>special://skin/extras/home-images/musicvideos.jpg</path>
			<icon>special://skin/extras/home-images/musicvideos.jpg</icon>
		</background>
		<background name="livetv" label="livetv" type="static">
			<path>special://skin/extras/home-images/livetv.jpg</path>
			<icon>special://skin/extras/home-images/livetv.jpg</icon>
		</background>
		<background name="radio" label="radio" type="static">
			<path>special://skin/extras/home-images/radio.jpg</path>
			<icon>special://skin/extras/home-images/radio.jpg</icon>
		</background>
		<background name="games" label="games" type="static">
			<path>special://skin/extras/home-images/games.jpg</path>
			<icon>special://skin/extras/home-images/games.jpg</icon>
		</background>
		<background name="addons" label="addons" type="static">
			<path>special://skin/extras/home-images/addons.jpg</path>
			<icon>special://skin/extras/home-images/addons.jpg</icon>
		</background>
		<background name="pictures" label="pictures" type="static">
			<path>special://skin/extras/home-images/pictures.jpg</path>
			<icon>special://skin/extras/home-images/pictures.jpg</icon>
		</background>
		<background name="video" label="video" type="static">
			<path>special://skin/extras/home-images/video.jpg</path>
			<icon>special://skin/extras/home-images/video.jpg</icon>
		</background>
		<background name="favorites" label="favorites" type="static">
			<path>special://skin/extras/home-images/favorites.jpg</path>
			<icon>special://skin/extras/home-images/favorites.jpg</icon>
		</background>
		<background name="weather" label="weather" type="static">
			<path>special://skin/extras/home-images/weather.jpg</path>
			<icon>special://skin/extras/home-images/weather.jpg</icon>
		</background>
		<background name="libreelec" label="libreelec" type="static">
			<path>special://skin/extras/home-images/libreelec.png</path>
			<icon>special://skin/extras/home-images/libreelec.png</icon>
		</background>
		<background name="coreelec" label="coreelec" type="static">

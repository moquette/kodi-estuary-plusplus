	<!-- Both rows below read $LOCALIZE[166] "Skin" until 2026-07-31. That was
	     not wrong, it was ambiguous: the identical word also sat on the icon
	     source in shortcuts/menus.xml, so one label named two different
	     folders. These two open home-images/, so they say Backgrounds.
	     31725 is the skin's own string rather than core 33069, which also
	     reads "Backgrounds" and is not wrong, but is marked "#: Unknown" in
	     Kodi's strings.po, meaning nothing in core consumes it. An unused core
	     string is a removal candidate, and if it went the add-on would render
	     the literal text $LOCALIZE[33069] here, because that is its fallback
	     when an id resolves to nothing (localize.py:58-61).
	     "Browse" on the second row of each pair is $LOCALIZE[1024] and is
	     deliberately untouched. -->
	<!-- icon= on a <source> is honoured for type="browse" and type="multi"
	     only. Those two land in browse_sources (loaders/background.py:110-117)
	     and are rendered by the SAME _browse_with_sources call the icon picker
	     uses, so the pair below matches shortcuts/menus.xml on purpose: folder
	     for "this skin's own images", magnifier for "go find your own". A
	     source under any other background type becomes a PlaylistSource
	     instead, where an absent icon falls back to DefaultPlaylist.png
	     (loaders/background.py:124) rather than to a placeholder. -->
	<background name="browse-image" label="$LOCALIZE[1030]" type="browse">
		<source label="$LOCALIZE[31725]" icon="DefaultFolder.png">special://skin/extras/home-images/</source>
		<source label="$LOCALIZE[1024]" icon="DefaultAddonsSearch.png">browse</source>
	</background>

	<background name="browse-folder" label="$LOCALIZE[657]" type="multi">
		<source label="$LOCALIZE[31725]" icon="DefaultFolder.png">special://skin/extras/home-images/</source>
		<source label="$LOCALIZE[1024]" icon="DefaultAddonsSearch.png">browse</source>
	</background>

</backgrounds>

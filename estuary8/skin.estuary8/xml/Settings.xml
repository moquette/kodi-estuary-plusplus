<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onunload>RunScript(special://skin/scripts/helpers.py,getKodiSetting,lookandfeel.startupaction)</onunload>
	<onunload condition="!String.IsEmpty(Window(home).property(lookandfeel.startupaction)) + !String.IsEqual(Window(home).property(lookandfeel.startupaction),0)">Skin.Reset(ShowSplashScreen)</onunload>
	<onunload>RunScript(special://skin/scripts/helpers.py,getKodiSetting,videolibrary.showunwatchedplots)</onunload>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>DefaultBackground</include>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>1520</width>
			<top>0</top>
			<bottom>0</bottom>
			<include>OpenClose_Right</include>
			<control type="group">
				<height>900</height>
				<centertop>50%</centertop>
				<control type="panel" id="9000">
					<left>0</left>
					<width>100%</width>
					<top>0</top>
					<height>260</height>
					<ondown>9001</ondown>
					<include>SettingsPanel</include>
					<content>
						<item>
							<label>$LOCALIZE[10003]</label>
							<onclick>ActivateWindow(filemanager)</onclick>
							<icon>icons/settings/filemanager.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[24001]</label>
							<onclick>ActivateWindow(addonbrowser)</onclick>
							<icon>icons/settings/addons.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[138]</label>
							<onclick>ActivateWindow(systeminfo)</onclick>
							<icon>icons/settings/sysinfo.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[31067]</label>
							<onclick>ActivateWindow(eventlog)</onclick>
							<icon>icons/settings/eventlog.png</icon>
						</item>
					</content>
				</control>
				<control type="label">
					<left>0</left>
					<right>0</right>
					<top>300</top>
					<height>50</height>
					<label>$LOCALIZE[5]</label>
					<align>center</align>
					<font>font37</font>
					<textcolor>grey</textcolor>
				</control>
				<control type="panel" id="9001">
					<left>0</left>
					<width>100%</width>
					<top>370</top>
					<height>520</height>
					<onup>9000</onup>
					<include>SettingsPanel</include>
					<content>
						<item>
							<label>$LOCALIZE[14200]</label>
							<onclick>ActivateWindow(PlayerSettings)</onclick>
							<icon>icons/settings/player.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[14211]</label>
							<onclick>ActivateWindow(MediaSettings)</onclick>
							<icon>icons/settings/media.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[14204]</label>
							<onclick>ActivateWindow(PVRSettings)</onclick>
							<icon>icons/settings/livetv.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[14036]</label>
							<onclick>ActivateWindow(ServiceSettings)</onclick>
							<icon>icons/settings/network.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[15016]</label>
							<visible>System.GetBool(gamesgeneral.enable) + !Skin.HasSetting(SkinSettingsTile)</visible>
							<onclick>ActivateWindow(GameSettings)</onclick>
							<icon>icons/settings/games.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[10035]</label>
							<visible>Skin.HasSetting(SkinSettingsTile) | !System.GetBool(gamesgeneral.enable)</visible>
							<onclick>ActivateWindow(SkinSettings)</onclick>
							<icon>icons/settings/skin.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[14206]</label>
							<onclick>ActivateWindow(InterfaceSettings)</onclick>
							<icon>icons/settings/interface.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[13200]</label>
							<onclick>ActivateWindow(Profiles)</onclick>
							<icon>icons/settings/profiles.png</icon>
						</item>
						<item>
							<label>$LOCALIZE[13000]</label>
							<onclick>ActivateWindow(SystemSettings)</onclick>
							<icon>icons/settings/system.png</icon>
						</item>
						<item>
							<label>LibreELEC</label>
							<visible>System.HasAddon(service.libreelec.settings)</visible>
							<onclick>RunAddon(service.libreelec.settings)</onclick>
							<icon>icons/settings/libreelec.png</icon>
						</item>
						<item>
							<label>CoreELEC</label>
							<visible>System.HasAddon(service.coreelec.settings)</visible>
							<onclick>RunAddon(service.coreelec.settings)</onclick>
							<icon>icons/settings/coreelec.png</icon>
						</item>
					</content>
				</control>
			</control>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[5]" />
		</include>
		<include>BottomBar</include>
	</controls>
</window>

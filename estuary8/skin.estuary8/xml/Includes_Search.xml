		<value>TMDb Helper</value>
	</variable>
	<variable name="ClearlogoVar">
		<value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="KeywordMoviesLabelVar">
		<value condition="String.IsEqual(Skin.String(current_search_provider),1) | String.IsEqual(Skin.String(current_search_provider),3) | String.IsEqual(Skin.String(current_search_provider),4) | String.IsEqual(Skin.String(current_search_provider),5)">TMDb Keywords (Movies)</value>
	</variable>
	<variable name="KeywordTVShowsLabelVar">
		<value condition="String.IsEqual(Skin.String(current_search_provider),1) | String.IsEqual(Skin.String(current_search_provider),3) | String.IsEqual(Skin.String(current_search_provider),4) | String.IsEqual(Skin.String(current_search_provider),5)">TMDb Keywords (TV Shows)</value>
	</variable>
	<variable name="TRAKTButtonActionsVar">
		<value condition="String.IsEqual(Skin.String(current_search_provider),0)">ActivateWindow(10025,plugin://plugin.video.themoviedb.helper/?info=trakt_searchlists&amp;tmdb_type=both,return)</value>
		<value condition="String.IsEqual(Skin.String(current_search_provider),1)">ActivateWindow(10025,plugin://plugin.video.fenlight/?&amp;mode=navigator.my_content&amp;name=My%20Lists,return)</value>
		<value condition="String.IsEqual(Skin.String(current_search_provider),2)">ActivateWindow(10025,plugin://plugin.video.umbrella/?action=trakt_Navigator,return)</value>
		<value condition="String.IsEqual(Skin.String(current_search_provider),3)">ActivateWindow(10025,plugin://plugin.video.pov/?mode=navigator.my_content&amp;name=32454,return)</value>
		<value condition="String.IsEqual(Skin.String(current_search_provider),4)">ActivateWindow(10025,plugin://plugin.video.gears/?&amp;mode=navigator.my_content&amp;name=My%20Lists,return)</value>
		<value condition="String.IsEqual(Skin.String(current_search_provider),5)">ActivateWindow(10025,plugin://plugin.video.redlight/?&amp;mode=navigator.my_content&amp;name=My%20Lists,return)</value>
		<value>ActivateWindow(10025,plugin://plugin.video.themoviedb.helper/?info=trakt_searchlists&amp;tmdb_type=both,return)</value>

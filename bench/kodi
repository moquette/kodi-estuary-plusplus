#!/usr/bin/env bash
# One entry point for the Estuary POV macOS workbench.
#
#   bench/kodi start | stop | restart | status
#   bench/kodi reload                 reload the skin in place, ~1s, no restart
#   bench/kodi push                   copy the repo skin over the installed one
#   bench/kodi skin [id]              show or switch skin, stop-write-start
#   bench/kodi rpc '<json>'           raw JSON-RPC
#   bench/kodi log [n]                tail the log
#   bench/kodi errors                 log lines Kodi flagged as error or warning
#   bench/kodi shot [name]            screenshot into bench/shots/
#   bench/kodi lib                    library counts
#   bench/kodi seed                   rebuild the synthetic library
#
# Rescued 2026-08-31 from the estuary-8 bench during the E7/E8 decommission and
# adapted to POV. The mechanisms (clean quit only, bundle verification, offline
# guisettings skin switch) are bench knowledge proven there; see the notes at
# each command.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="${KODI_APP:-$HOME/Applications/Kodi22.app}"
# ~/Applications/Kodi22.app is a SYMLINK to /Applications/Kodi.app, so that the
# 22 bundle owns the bare name `Kodi` that `open -a Kodi` resolves while this
# hardcoded path still works. `ps -o comm=` always reports the PHYSICAL path, so
# the bundle check in start() has to compare against the resolved path or a
# perfectly healthy launch reports WRONG BUNDLE and exits 1. Measured 2026-07-28.
APP_REAL="$(cd "$APP" 2>/dev/null && pwd -P || echo "$APP")"
KHOME="${KODI_HOME:-$HOME/Library/Application Support/Kodi}"
LOG="${KODI_LOG:-$HOME/Library/Logs/kodi.log}"
RPC="http://localhost:8080/jsonrpc"

rpc() { curl -s -m 30 -u kodi:kodi -H 'Content-Type: application/json' -d "$1" "$RPC"; }
running() { pgrep -f 'MacOS/Kodi' >/dev/null; }

wait_pong() {
  for _ in $(seq 1 60); do
    rpc '{"jsonrpc":"2.0","method":"JSONRPC.Ping","id":1}' 2>/dev/null | grep -q pong && return 0
    sleep 1
  done
  echo "no JSON-RPC pong on 8080" >&2
  return 1
}

# Always a CLEAN quit. A killed Kodi loses guisettings.xml, which is where the
# active skin lives, so a kill can silently revert a skin switch.
stop() {
  running || {
    echo "already stopped"
    return 0
  }
  osascript -e 'quit app "Kodi"' >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do
    running || {
      echo "stopped"
      return 0
    }
    sleep 1
  done
  echo "Kodi will not quit. NOT forcing it: an unclean exit loses guisettings.xml." >&2
  return 1
}

appdir() { ps -o comm= -p "$(pgrep -f 'MacOS/Kodi' | head -1)" 2>/dev/null; }

start() {
  running && {
    echo "already running"
    wait_pong
    return 0
  }
  open -a "$APP"
  wait_pong || return 1
  # `open -a <path>` is NOT a guarantee of which bundle starts. LaunchServices
  # resolves org.xbmc.kodi against every registered copy, and a second copy on
  # disk can win: that is exactly how a scratchpad build kept relaunching after
  # the durable one was installed. Verify, do not assume.
  got="$(appdir)"
  case "$got" in
    "$APP_REAL"/*) ;;
    *)
      echo "WRONG BUNDLE: $got" >&2
      echo "expected:     $APP_REAL (via $APP)" >&2
      echo "fix: rm the other copy, then lsregister -f \"$APP\"" >&2
      return 1
      ;;
  esac
  echo "up: $APP"
  echo "    skin $(rpc '{"jsonrpc":"2.0","method":"Settings.GetSettingValue","params":{"setting":"lookandfeel.skin"},"id":1}' | sed 's/.*"value":"//;s/".*//')"
}

SKINID="skin.estuary.pov"
SKINSRC="$REPO/$SKINID"
SKINDST="$KHOME/addons/$SKINID"
KEYMAP="$KHOME/userdata/keymaps/pov-dev.xml"

cmd="${1:-status}"
shift || true

case "$cmd" in
  start) start ;;
  stop) stop ;;
  push)
    # Copy the repo skin over the installed one, then reload.
    #
    # A SYMLINK from addons/<skin> to the repo was tried on the estuary-8 bench
    # and did NOT survive on this machine: within three minutes it had been
    # replaced by a real directory, and the replacement had silently DROPPED
    # every empty directory, including all of themes/. The cause was never
    # established, which is exactly why the symlink is not trusted. An explicit
    # push cannot be undone behind your back.
    #
    # --delete is on purpose: without it, a file deleted in the repo lingers in
    # the installed skin and you debug a file that no longer exists.
    [ -d "$SKINSRC" ] || {
      echo "no skin source at $SKINSRC" >&2
      exit 1
    }
    rsync -a --delete --exclude '.DS_Store' "$SKINSRC/" "$SKINDST/"
    echo "pushed $(find "$SKINSRC" -type f | wc -l | tr -d ' ') files"
    diff -rq "$SKINSRC" "$SKINDST" >/dev/null 2>&1 && echo "verified: installed == repo" || echo "WARNING: trees still differ" >&2
    running && "$0" reload
    ;;
  restart)
    stop
    start
    ;;
  status)
    if running; then
      echo "running  pid $(pgrep -f 'MacOS/Kodi')"
      echo "app      $(ps -o comm= -p "$(pgrep -f 'MacOS/Kodi' | head -1)")"
      rpc '{"jsonrpc":"2.0","method":"Application.GetProperties","params":{"properties":["version","name"]},"id":1}'
      echo
      rpc '{"jsonrpc":"2.0","method":"Settings.GetSettingValue","params":{"setting":"lookandfeel.skin"},"id":1}'
      echo
    else
      echo "stopped"
    fi
    ;;
  reload)
    # ReloadSkin() is a Kodi builtin and JSON-RPC has no builtin runner, so this
    # goes through a keyboard binding: userdata/keymaps/pov-dev.xml maps F5 to
    # ReloadSkin(), and Input.ButtonEvent presses it. bench/reset-bench writes
    # that keymap during provisioning; keymaps load at Kodi start, so a keymap
    # written now needs one restart before F5 lands.
    if [ ! -f "$KEYMAP" ]; then
      mkdir -p "$(dirname "$KEYMAP")"
      printf '<keymap>\n  <global>\n    <keyboard>\n      <f5>ReloadSkin()</f5>\n    </keyboard>\n  </global>\n</keymap>\n' > "$KEYMAP"
      echo "wrote $KEYMAP; restart Kodi once so it loads, then reload works" >&2
      exit 1
    fi
    rpc '{"jsonrpc":"2.0","method":"Input.ButtonEvent","params":{"button":"f5","keymap":"KB"},"id":1}'
    echo
    sleep 2
    grep -E 'load skin from' "$LOG" | tail -1
    ;;
  skin)
    if [ $# -eq 0 ]; then
      rpc '{"jsonrpc":"2.0","method":"Settings.GetSettingValue","params":{"setting":"lookandfeel.skin"},"id":1}'
      echo
      exit 0
    fi
    # Never switch skins over JSON-RPC. Kodi raises a "keep this skin?" countdown
    # and silently reverts when nothing answers it, which looks exactly like a
    # failed load. Writing guisettings.xml while Kodi is stopped has no dialog.
    rpc "{\"jsonrpc\":\"2.0\",\"method\":\"Addons.SetAddonEnabled\",\"params\":{\"addonid\":\"$1\",\"enabled\":true},\"id\":1}" >/dev/null 2>&1 || true
    stop
    SKIN="$1" python3 - <<'PY'
import os, re
p = os.path.expanduser("~/Library/Application Support/Kodi/userdata/guisettings.xml")
s = open(p, encoding="utf-8").read()
s2 = re.sub(r'(<setting id="lookandfeel\.skin")[^>]*>[^<]*</setting>',
            r'\1>' + os.environ["SKIN"] + '</setting>', s, count=1)
assert s2 != s, "lookandfeel.skin not found in guisettings.xml"
open(p, "w", encoding="utf-8").write(s2)
PY
    start
    grep -E 'load skin from|Failed to load skin' "$LOG" | tail -1
    ;;
  rpc)
    rpc "$1"
    echo
    ;;
  log) tail -n "${1:-60}" "$LOG" ;;
  errors) grep -iE '(error|warning) <' "$LOG" | tail -n "${1:-40}" ;;
  shot)
    mkdir -p "$REPO/bench/shots"
    rpc "{\"jsonrpc\":\"2.0\",\"method\":\"Settings.SetSettingValue\",\"params\":{\"setting\":\"debug.screenshotpath\",\"value\":\"$REPO/bench/shots/\"},\"id\":1}" >/dev/null
    rpc '{"jsonrpc":"2.0","method":"Input.ExecuteAction","params":{"action":"screenshot"},"id":1}' >/dev/null
    sleep 2
    latest="$(/bin/ls -t "$REPO/bench/shots/"screenshot*.png 2>/dev/null | head -1)"
    if [ -n "${1:-}" ] && [ -n "$latest" ]; then
      mv "$latest" "$REPO/bench/shots/$1.png"
      latest="$REPO/bench/shots/$1.png"
    fi
    echo "$latest"
    ;;
  lib)
    python3 - <<'PY'
import base64, json, urllib.request
URL = "http://localhost:8080/jsonrpc"
AUTH = "Basic " + base64.b64encode(b"kodi:kodi").decode()
def J(m, p=None):
    b = json.dumps({"jsonrpc": "2.0", "method": m, "params": p or {}, "id": 1}).encode()
    return json.load(urllib.request.urlopen(urllib.request.Request(
        URL, b, {"Content-Type": "application/json", "Authorization": AUTH}), timeout=30))
def n(m, p=None):
    return J(m, p)["result"]["limits"]["total"]
print("movies       ", n("VideoLibrary.GetMovies"))
print("  watched    ", n("VideoLibrary.GetMovies", {"filter": {"field": "playcount", "operator": "greaterthan", "value": "0"}}))
print("  in progress", n("VideoLibrary.GetMovies", {"filter": {"field": "inprogress", "operator": "true", "value": ""}}))
print("tvshows      ", n("VideoLibrary.GetTVShows"))
print("episodes     ", n("VideoLibrary.GetEpisodes"))
print("  unwatched  ", n("VideoLibrary.GetEpisodes", {"filter": {"field": "playcount", "operator": "is", "value": "0"}}))
PY
    ;;
  seed) "$REPO/bench/seed-library.sh" ;;
  *)
    sed -n '2,14p' "$0"
    exit 1
    ;;
esac

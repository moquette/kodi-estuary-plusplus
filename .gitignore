.DS_Store
._*
__MACOSX/
*.zip

# Build output. tools/build_skin.py writes dist/<id>-<version>.zip, which is
# reproducible from any commit, so it is never tracked. The *.zip line above
# already covered today's contents; this covers anything non-zip a future build
# step drops in there.
/dist/

# Python bytecode from the test run and the boot service.
__pycache__/
*.pyc

# Synthetic bench library and screenshots, generated by bench/ tooling.
# Derived deterministically (seed-library.py fixed RNG seed); delete and
# re-run rather than tracking binary churn.
bench/media/
bench/shots/
